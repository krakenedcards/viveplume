---
import { getCollection } from 'astro:content';
import Page from '../../../layouts/Page.astro';
import { chapterUrl } from '../../../markdown.mjs';
export async function getStaticPaths() {
  const chapters = await getCollection('chapitres');
  return (await getCollection('romans')).map(({ data: book }) => ({
    params: { slug: book.slug }, props: { book, chapters: chapters.map(c => c.data).filter(c => c.roman === book.slug).sort((a,b) => a.numero-b.numero) }
  }));
}
const { book, chapters } = Astro.props;
---
<Page title={book.titre}><h1>{book.titre}</h1>{book.resume && <p>{book.resume}</p>}<h2>Sommaire</h2>
{chapters.length ? <ol>{chapters.map(c => <li value={c.numero}><a href={chapterUrl(c.file)}>{c.titre}</a></li>)}</ol> : <p>Bientôt disponible</p>}</Page>
